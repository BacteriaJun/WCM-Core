(set-logic QF_BV)
(set-option :produce-models true)
(declare-const state (_ BitVec 3))
(declare-const state_next (_ BitVec 3))
(declare-const reports (_ BitVec 6))
(declare-const reports_next (_ BitVec 6))
(declare-const maximum (_ BitVec 6))
(declare-const reset_ok Bool)
(declare-const verified Bool)
(declare-const invalid Bool)
(declare-const abort Bool)
(declare-const due Bool)
(declare-const accept Bool)
(declare-const started Bool)
(declare-const full_frame_closed Bool)
(declare-const quarantined Bool)
(declare-const phy_settled_this_frame Bool)
(declare-const settle_pulse Bool)
(declare-const settle_after_quarantine Bool)
(declare-const settled_ok Bool)
(declare-const dirty Bool)
(declare-const world_break Bool)
(define-fun commit () Bool (and started full_frame_closed quarantined phy_settled_this_frame settle_pulse settle_after_quarantine settled_ok reset_ok (not dirty) (not world_break)))
(define-fun complete () Bool commit)
(define-fun count_step () Bool (and reset_ok (not (or invalid abort)) (= state (_ bv3 3)) complete))
(define-fun inc () (_ BitVec 6) (bvadd reports (_ bv1 6)))
(assert (= state_next (ite (not reset_ok) (_ bv0 3)
      (ite (or invalid abort) (_ bv5 3)
        (ite (and (= state (_ bv0 3)) verified) (_ bv1 3)
          (ite (and (= state (_ bv1 3)) due) (_ bv2 3)
            (ite (and (= state (_ bv2 3)) accept) (_ bv3 3)
              (ite count_step (ite (bvuge inc maximum) (_ bv4 3) (_ bv1 3)) state))))))))
(assert (= reports_next (ite (not reset_ok) (_ bv0 6) (ite count_step inc reports))))
(define-fun inv () Bool (and (or (= state (_ bv0 3)) (= state (_ bv1 3)) (= state (_ bv2 3)) (= state (_ bv3 3)) (= state (_ bv4 3)) (= state (_ bv5 3))) (not (= maximum (_ bv0 6))) (bvule reports maximum) (or (not (or (= state (_ bv1 3)) (= state (_ bv2 3)) (= state (_ bv3 3)))) (bvult reports maximum)) (or (not (= state (_ bv0 3))) (= reports (_ bv0 6))) (or (not (= state (_ bv4 3))) (= reports maximum))))
(define-fun inv_next () Bool (and (or (= state_next (_ bv0 3)) (= state_next (_ bv1 3)) (= state_next (_ bv2 3)) (= state_next (_ bv3 3)) (= state_next (_ bv4 3)) (= state_next (_ bv5 3))) (not (= maximum (_ bv0 6))) (bvule reports_next maximum) (or (not (or (= state_next (_ bv1 3)) (= state_next (_ bv2 3)) (= state_next (_ bv3 3)))) (bvult reports_next maximum)) (or (not (= state_next (_ bv0 3))) (= reports_next (_ bv0 6))) (or (not (= state_next (_ bv4 3))) (= reports_next maximum))))
(define-fun request () Bool (and reset_ok verified (not invalid) (= state (_ bv2 3))))
(assert inv)
(assert (not inv_next))
(check-sat)
