(set-logic QF_BV)
(set-option :produce-models true)
(declare-const state (_ BitVec 3))
(declare-const state_next (_ BitVec 3))
(declare-const elapsed (_ BitVec 16))
(declare-const elapsed_next (_ BitVec 16))
(declare-const reports (_ BitVec 6))
(declare-const reports_next (_ BitVec 6))
(declare-const tick Bool)
(declare-const due Bool)
(declare-const accept Bool)
(declare-const complete Bool)
(declare-const abort Bool)
(declare-const reset_ok Bool)
(define-fun overflow () Bool (and tick (= elapsed (_ bv65535 16))))
(define-fun active () Bool (or (= state (_ bv1 3)) (= state (_ bv2 3)) (= state (_ bv3 3))))
(assert (= state_next (ite (not reset_ok) (_ bv0 3)
      (ite abort (_ bv5 3)
        (ite (and (or (= state (_ bv1 3)) (= state (_ bv2 3)) (= state (_ bv3 3))) (and tick (= elapsed (_ bv65535 16)))) (_ bv5 3)
          (ite (and (= state (_ bv1 3)) due) (_ bv2 3)
            (ite (and (= state (_ bv2 3)) accept) (_ bv3 3)
              (ite (and (= state (_ bv3 3)) complete) (_ bv1 3) state))))))))
(assert (= elapsed_next (ite (not reset_ok) (_ bv0 16) (ite (and active tick (not overflow)) (bvadd elapsed (_ bv1 16)) elapsed))))
(assert (= reports_next (ite (not reset_ok) (_ bv0 6) (ite (and active (not abort) (not overflow) (= state (_ bv3 3)) complete) (bvadd reports (_ bv1 6)) reports))))
(assert reset_ok)(assert active)(assert overflow)(assert (not (= reports_next reports)))
(check-sat)
