(set-logic QF_BV)
(set-option :produce-models true)
(declare-const count (_ BitVec 6))
(declare-const count_next (_ BitVec 6))
(declare-const verified Bool)
(declare-const verified_next Bool)
(declare-const invalid Bool)
(declare-const invalid_next Bool)
(declare-const reset_ok Bool)
(declare-const bit_valid Bool)
(declare-const candidate_ok Bool)
(define-fun last_bit () Bool (= count (_ bv63 6)))
(define-fun incoming () Bool (and reset_ok bit_valid (not invalid)))
(assert (= count_next (ite (not reset_ok) (_ bv0 6) (ite (and incoming (not verified) (not last_bit)) (bvadd count (_ bv1 6)) count))))
(assert (= verified_next (ite (not reset_ok) false (ite (and incoming verified) false (ite (and incoming last_bit) candidate_ok verified)))))
(assert (= invalid_next (ite (not reset_ok) false (ite (and incoming verified) true (ite (and incoming last_bit) (not candidate_ok) invalid)))))
(define-fun inv () Bool (and (or (not verified) (= count (_ bv63 6))) (or (not invalid) (= count (_ bv63 6))) (not (and verified invalid))))
(define-fun inv_next () Bool (and (or (not verified_next) (= count_next (_ bv63 6))) (or (not invalid_next) (= count_next (_ bv63 6))) (not (and verified_next invalid_next))))
(assert inv)
(assert reset_ok)(assert verified)(assert bit_valid)(assert (or verified_next (not invalid_next)))
(check-sat)
